DATABASE_URL=postgres://htafl:htafl@localhost:5432/htafl
# Integration tests recreate the public schema here. Must be a separate database ending in _test.
TEST_DATABASE_URL=postgres://htafl:htafl@localhost:5432/htafl_test
JWT_SECRET=replace-with-a-long-random-string
PORT=3000
# Set to false for local testing only. Real sign-ups must verify their email.
REQUIRE_VERIFIED_EMAIL=true
# Raise these as the community grows (the plan suggests 10 for Featured at scale).
FEATURED_MIN_VOTERS=3
RISING_MIN_VOTERS=3
# Set to 1 when running behind a proxy or load balancer so rate limits see real IPs.
TRUST_PROXY=0

# The web app's address. Used for verification links and to block forged cross-site requests.
APP_ORIGIN=http://localhost:3001
# Email: empty prints links only in local development. Production registration returns 503.
# For STARTTLS providers include ?requireTLS=true in the URL.
# Example: smtp://username:password@smtp.yourprovider.com:587
SMTP_URL=
MAIL_FROM="HTAFL <no-reply@yourdomain.com>"
# Optional reply emails: off for members until opt-in. Maximum 100 attempts/day.
# Set 0 to pause reply delivery while retaining queued jobs. Verification is separate.
REPLY_EMAIL_DAILY_LIMIT=100
# Use immediate to publish validated picture/video posts without approval.
# Use manual only when moderator approval before publication is wanted.
# Empty keeps production uploads disabled. Local legacy picture flow remains available.
MEDIA_REVIEW_MODE=
# Private S3-compatible bucket; cap object size at 10 MB in the storage provider.
# Supabase: https://PROJECT.storage.supabase.co/storage/v1/s3, region eu-central-1.
# S3 credentials are server-only and bypass Supabase storage RLS. Never use a public bucket.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Only needed for the legacy local/public-picture flow. Leave empty for private storage.
S3_PUBLIC_BASE=
